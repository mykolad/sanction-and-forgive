* text=auto

# Bicep and parameter files as LF everywhere: the alert query is a multi-line string, and a CRLF checkout
# would deploy a different query from CI's (what-if would show it changing on every run).
*.bicep text eol=lf
*.bicepparam text eol=lf

# Conformance golden files: written by the reference implementation (docs/conformance.md), one JSON per line.
tests/conformance/golden/** text eol=lf linguist-generated=true

# The matcher dictionaries as LF everywhere: their bytes are hashed into the matcher version, so a Windows checkout
# (CRLF) would report a different version from the same dictionaries (docs/conformance.md).
src/SanctionAndForgive.Matching/Data/** text eol=lf

# The Go port: LF, as gofmt writes it.
ports/go/** text eol=lf
