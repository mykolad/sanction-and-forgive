<Project Sdk="Microsoft.NET.Sdk">

  <!-- The conformance suite: a black-box test of a running implementation (any language) through its HTTP API, its
       CLI and the shared database. It references none of the app's projects on purpose. docs/conformance.md. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
