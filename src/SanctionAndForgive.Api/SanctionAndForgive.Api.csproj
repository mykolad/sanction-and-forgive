<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>sanction-and-forgive-api</UserSecretsId>
    <!-- One replica with 0.25 vCPU and 0.5 GiB: a compact heap matters more than GC throughput. Workstation GC (as a
         1-core container would pick anyway, made explicit), no background GC, and ConserveMemory, which compacts the
         large indexes rather than growing the heap (docs/memory.md, Phase 3 measurements). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SanctionAndForgive.Matching\SanctionAndForgive.Matching.csproj" />
    <ProjectReference Include="..\SanctionAndForgive.Data\SanctionAndForgive.Data.csproj" />
    <!-- The feed catalogue only (ListSources: pages, terms, why a feed isn't imported), for /api/v1/sources. -->
    <ProjectReference Include="..\SanctionAndForgive.Lists\SanctionAndForgive.Lists.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SanctionAndForgive.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations tooling only (dotnet ef, with this project as the startup project); not shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
